// =============================================================================
// LOOPLY PRISMA SCHEMA (V1)
// =============================================================================
// Multi-tenant, mobile-first loyalty platform.
// Strict tenancy isolation, role-based semantics, and relational integrity.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum VerificationMethod {
  BILL
  VISIT_CONFIRMATION
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RewardStatus {
  AVAILABLE
  REDEEMED
  EXPIRED
}

enum RewardType {
  STANDARD
  SCRATCH_CARD
}

enum WindowType {
  LIFETIME
  ROLLING
  FIXED_PERIOD
}

// -----------------------------------------------------------------------------
// USER & AUTH
// -----------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Single business owned in V1
  ownedBusiness        Business?
  // Active sessions
  sessions             Session[]

  // Rewards redeemed by this business owner (audit trail)
  redeemedRewards      Reward[]              @relation("RedeemedBy")
  // Legal acceptances (Terms, Privacy)
  legalAcceptances     LegalAcceptance[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([sessionToken])
}

// -----------------------------------------------------------------------------
// LEGAL CONSENT
// -----------------------------------------------------------------------------

model LegalAcceptance {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  termsVersion      String
  termsAcceptedAt   DateTime
  privacyVersion    String
  privacyAcceptedAt DateTime
  createdAt         DateTime @default(now())

  @@index([userId])
}

// -----------------------------------------------------------------------------
// CUSTOMER (Mobile Number Identity)
// -----------------------------------------------------------------------------

model Customer {
  id           String   @id @default(cuid())
  mobileNumber String
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships          Membership[]
  visitRequests        VisitRequest[]
  visits               Visit[]
  rewards              Reward[]

  @@unique([businessId, mobileNumber])
  @@index([mobileNumber])
  @@index([businessId])
}

// -----------------------------------------------------------------------------
// BUSINESS & LOYALTY PROGRAM
// -----------------------------------------------------------------------------

model Business {
  id            String   @id @default(cuid())
  name          String
  // Permanent unique public QR token used in /join/{businessToken}
  businessToken String   @unique
  ownerId       String   @unique
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  googleReviewUrl String?
  instagramHandle String?
  youtubeHandle   String?
  address         String?
  businessType    String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  loyaltyProgram       LoyaltyProgram?
  campaigns            Campaign[]
  memberships          Membership[]
  customers            Customer[]
  visitRequests        VisitRequest[]
  visits               Visit[]
  rewards              Reward[]

  @@index([ownerId])
  @@index([businessToken])
}

model LoyaltyProgram {
  id                 String             @id @default(cuid())
  businessId         String             @unique
  business           Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  programName        String
  requiredVisits     Int                @default(10)
  // How the requiredVisits threshold is counted:
  //   LIFETIME     — all approved visits ever (existing behavior)
  //   ROLLING      — visits within the trailing windowDays, re-anchored after each reward
  //   FIXED_PERIOD — visits since windowStartsAt
  windowType         WindowType         @default(LIFETIME)
  windowDays         Int?               // required (Zod-enforced) when windowType == ROLLING
  windowStartsAt     DateTime?          // required (Zod-enforced) when windowType == FIXED_PERIOD
  rewardTitle        String
  rewardDescription  String
  rewardValidityDays Int                @default(30)
  verificationMethod VerificationMethod @default(VISIT_CONFIRMATION)
  isActive           Boolean            @default(true)
  // Set true only for programs auto-paused when scratch-card mode was retired from
  // LoyaltyProgram in favor of the standalone Campaign subsystem — drives a one-time
  // dashboard banner for the affected owner, cleared once they dismiss it.
  retiredScratchNotice Boolean          @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  rewards           Reward[]
  scratchCardPrizes ScratchCardPrize[]

  @@index([businessId])
}

// -----------------------------------------------------------------------------
// SCRATCH CARD PRIZE (LEGACY — frozen historical data only)
// -----------------------------------------------------------------------------
// Retained solely to preserve referential integrity for pre-existing LoyaltyProgram
// (type = SCRATCH_CARD) rows and their historical Reward rows. No new code path creates
// rows here — scratch-style plays now live entirely under the Campaign subsystem below.

model ScratchCardPrize {
  id               String         @id @default(cuid())
  loyaltyProgramId String
  loyaltyProgram   LoyaltyProgram @relation(fields: [loyaltyProgramId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  weight           Int
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  rewards          Reward[]

  @@index([loyaltyProgramId])
}

// -----------------------------------------------------------------------------
// CAMPAIGN (Standalone promotional scratch-card campaigns — independent of the
// loyalty program; not tied to a visit, purchase, or approval)
// -----------------------------------------------------------------------------

model Campaign {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  campaignToken   String   @unique
  startsAt        DateTime
  endsAt          DateTime?
  endedManuallyAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  prizes CampaignPrize[]
  plays  CampaignPlay[]

  @@index([businessId])
  @@index([campaignToken])
}

model CampaignPrize {
  id             String   @id @default(cuid())
  campaignId     String
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title          String
  weight         Int
  totalStock     Int
  remainingStock Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  plays CampaignPlay[]

  @@index([campaignId])
}

model CampaignPlay {
  id            String         @id @default(cuid())
  campaignId    String
  campaign      Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  mobileNumber  String
  customerName  String?
  wonPrizeId    String?
  wonPrize      CampaignPrize? @relation(fields: [wonPrizeId], references: [id], onDelete: SetNull)
  revealedPrize String
  playedAt      DateTime       @default(now())

  // The one-play-per-mobile-number-per-campaign gate, enforced at the DB level.
  @@unique([campaignId, mobileNumber])
  @@index([campaignId])
}

// -----------------------------------------------------------------------------
// MEMBERSHIP (Customer <-> Business Association)
// -----------------------------------------------------------------------------

model Membership {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // currentVisits removed — a resettable running counter cannot represent a rolling or
  // fixed-period window. Progress is now always computed from Visit rows at read time
  // (see src/lib/loyaltyProgress.ts). totalVisits is safe to keep stored: it is a pure
  // lifetime tally with no window semantics, so it never needs to "reset" or go stale.
  totalVisits   Int      @default(0) // Lifetime verified visits count
  reviewPromptedAt DateTime?
  joinedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  visitRequests        VisitRequest[]
  visits               Visit[]
  rewards              Reward[]

  // A customer can belong to the same business only once
  @@unique([customerId, businessId])
  @@index([customerId])
  @@index([businessId])
}

// -----------------------------------------------------------------------------
// VERIFICATION REQUEST (Evidence / Approval Submission)
// -----------------------------------------------------------------------------

model VisitRequest {
  id              String             @id @default(cuid())
  membershipId    String
  membership      Membership         @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  businessId      String
  business        Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  enteredName     String?
  method          VerificationMethod
  billImagePath   String? // Supabase Storage object path (nullable for VISIT_CONFIRMATION)
  billNumber      String? // customer-typed bill/receipt number, required (Zod) when method == BILL
  billImageHash   String? // perceptual dHash (hex), required (Zod) when method == BILL
  // Soft flag, not a hard reject — the owner is the final arbiter. Set when billNumber or
  // billImageHash matches another VisitRequest for the same business within the last 90
  // days, surfaced as a warning badge in BusinessRequestsPanel before approval.
  duplicateSuspected  Boolean       @default(false)
  duplicateOfRequestId String?
  duplicateOfRequest   VisitRequest? @relation("DuplicateOf", fields: [duplicateOfRequestId], references: [id], onDelete: SetNull)
  duplicateFlaggedBy   VisitRequest[] @relation("DuplicateOf")
  status          RequestStatus      @default(PENDING)
  rejectionReason String?
  reviewedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  visit Visit?

  @@index([businessId, status])
  @@index([membershipId])
  @@index([customerId])
  @@index([status])
  @@index([businessId, billNumber])
  @@index([businessId, billImageHash])
}

// -----------------------------------------------------------------------------
// VISIT (Immutable Verified Loyalty Event)
// -----------------------------------------------------------------------------

model Visit {
  id                    String               @id @default(cuid())
  membershipId          String
  membership            Membership           @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  businessId            String
  business              Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId            String
  customer              Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  verificationRequestId String?              @unique
  verificationRequest   VisitRequest?        @relation(fields: [verificationRequestId], references: [id], onDelete: SetNull)
  visitedAt             DateTime             @default(now())

  thresholdCompletionFor Reward[]            @relation("ThresholdCompletingVisit")

  @@index([membershipId])
  @@index([businessId])
  @@index([customerId])
  @@index([visitedAt])
  // Composite: efficient "visits for this membership since <date>" range scans, used by
  // both threshold-eligibility computation and the read-only progress endpoints.
  @@index([membershipId, visitedAt])
}

// -----------------------------------------------------------------------------
// REWARD (Earned Benefit from Loyalty Threshold)
// -----------------------------------------------------------------------------

model Reward {
  id               String         @id @default(cuid())
  membershipId     String
  membership       Membership     @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  businessId       String
  business         Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId       String
  customer         Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  loyaltyProgramId String
  loyaltyProgram   LoyaltyProgram @relation(fields: [loyaltyProgramId], references: [id], onDelete: Restrict)
  title              String
  description        String
  status             RewardStatus      @default(AVAILABLE)
  type               RewardType        @default(STANDARD)
  claimCode          String?           // Used for VISITS program one-time code claim
  scratchCardPrizeId String?
  scratchCardPrize   ScratchCardPrize? @relation(fields: [scratchCardPrizeId], references: [id], onDelete: SetNull)
  isScratched        Boolean           @default(false)
  revealedPrize      String?
  // Which ordinal threshold-crossing this reward represents (1, 2, 3, ...) for a given
  // membership+program — null for non-threshold reward rows (including every historical
  // SCRATCH_CARD row). The unique constraint below is the DB-level guarantee that the same
  // cycle can never be minted twice for one membership+program, regardless of application
  // bugs or concurrent approval attempts.
  thresholdCycle     Int?
  // The specific Visit whose approval completed this threshold cycle — used as the anchor
  // for the next cycle's window start in ROLLING mode. Null on backfilled historical rows,
  // where no such link was ever tracked.
  thresholdVisitId   String?
  thresholdVisit     Visit?            @relation("ThresholdCompletingVisit", fields: [thresholdVisitId], references: [id], onDelete: SetNull)
  expiresAt        DateTime
  redeemedAt       DateTime?
  redeemedByUserId String?
  redeemedByUser   User?          @relation("RedeemedBy", fields: [redeemedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([membershipId])
  @@index([businessId])
  @@index([customerId])
  @@index([status])
  // NULL-safe: Postgres allows multiple NULLs, so this only constrains actual
  // threshold-triggered rewards, never colliding with non-threshold reward rows.
  @@unique([membershipId, loyaltyProgramId, thresholdCycle])
}
