// =============================================================================
// LOOPLY PRISMA SCHEMA (V1)
// =============================================================================
// Multi-tenant, mobile-first loyalty platform.
// Strict tenancy isolation, role-based semantics, and relational integrity.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum VerificationMethod {
  BILL
  VISIT_CONFIRMATION
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RewardStatus {
  AVAILABLE
  REDEEMED
  EXPIRED
}

enum RewardType {
  STANDARD
  SCRATCH_CARD
}

// -----------------------------------------------------------------------------
// USER & AUTH
// -----------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Single business owned in V1
  ownedBusiness        Business?
  // Active sessions
  sessions             Session[]

  // Rewards redeemed by this business owner (audit trail)
  redeemedRewards      Reward[]              @relation("RedeemedBy")
  // Legal acceptances (Terms, Privacy)
  legalAcceptances     LegalAcceptance[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([sessionToken])
}

// -----------------------------------------------------------------------------
// LEGAL CONSENT
// -----------------------------------------------------------------------------

model LegalAcceptance {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  termsVersion      String
  termsAcceptedAt   DateTime
  privacyVersion    String
  privacyAcceptedAt DateTime
  createdAt         DateTime @default(now())

  @@index([userId])
}

// -----------------------------------------------------------------------------
// CUSTOMER (Mobile Number Identity)
// -----------------------------------------------------------------------------

model Customer {
  id           String   @id @default(cuid())
  mobileNumber String
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships          Membership[]
  visitRequests        VisitRequest[]
  visits               Visit[]
  rewards              Reward[]

  @@unique([businessId, mobileNumber])
  @@index([mobileNumber])
  @@index([businessId])
}

// -----------------------------------------------------------------------------
// BUSINESS & LOYALTY PROGRAM
// -----------------------------------------------------------------------------

model Business {
  id            String   @id @default(cuid())
  name          String
  // Permanent unique public QR token used in /join/{businessToken}
  businessToken String   @unique
  ownerId       String   @unique
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  googleReviewUrl String?
  instagramHandle String?
  youtubeHandle   String?
  address         String?
  businessType    String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  loyaltyProgram       LoyaltyProgram?
  memberships          Membership[]
  customers            Customer[]
  visitRequests        VisitRequest[]
  visits               Visit[]
  rewards              Reward[]

  @@index([ownerId])
  @@index([businessToken])
}

model LoyaltyProgram {
  id                 String             @id @default(cuid())
  businessId         String             @unique
  business           Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  programName        String
  visitsEnabled      Boolean            @default(true)
  scratchCardEnabled Boolean            @default(false)
  requiredVisits     Int                @default(10)
  rewardTitle        String
  rewardDescription  String
  rewardValidityDays Int                @default(30)
  verificationMethod VerificationMethod @default(VISIT_CONFIRMATION)
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  rewards           Reward[]
  scratchCardPrizes ScratchCardPrize[]

  @@index([businessId])
}

// -----------------------------------------------------------------------------
// SCRATCH CARD PRIZE (For SCRATCH_CARD programs)
// -----------------------------------------------------------------------------

model ScratchCardPrize {
  id               String         @id @default(cuid())
  loyaltyProgramId String
  loyaltyProgram   LoyaltyProgram @relation(fields: [loyaltyProgramId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  weight           Int
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  rewards          Reward[]

  @@index([loyaltyProgramId])
}

// -----------------------------------------------------------------------------
// MEMBERSHIP (Customer <-> Business Association)
// -----------------------------------------------------------------------------

model Membership {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  currentVisits Int      @default(0) // Progress towards current reward threshold
  totalVisits   Int      @default(0) // Lifetime verified visits count
  reviewPromptedAt DateTime?
  joinedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  visitRequests        VisitRequest[]
  visits               Visit[]
  rewards              Reward[]

  // A customer can belong to the same business only once
  @@unique([customerId, businessId])
  @@index([customerId])
  @@index([businessId])
}

// -----------------------------------------------------------------------------
// VERIFICATION REQUEST (Evidence / Approval Submission)
// -----------------------------------------------------------------------------

model VisitRequest {
  id              String             @id @default(cuid())
  membershipId    String
  membership      Membership         @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  businessId      String
  business        Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  enteredName     String?
  method          VerificationMethod
  billImagePath   String? // Supabase Storage object path (nullable for VISIT_CONFIRMATION)
  status          RequestStatus      @default(PENDING)
  rejectionReason String?
  reviewedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  visit Visit?

  @@index([businessId, status])
  @@index([membershipId])
  @@index([customerId])
  @@index([status])
}

// -----------------------------------------------------------------------------
// VISIT (Immutable Verified Loyalty Event)
// -----------------------------------------------------------------------------

model Visit {
  id                    String               @id @default(cuid())
  membershipId          String
  membership            Membership           @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  businessId            String
  business              Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId            String
  customer              Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  verificationRequestId String?              @unique
  verificationRequest   VisitRequest?        @relation(fields: [verificationRequestId], references: [id], onDelete: SetNull)
  visitedAt             DateTime             @default(now())

  @@index([membershipId])
  @@index([businessId])
  @@index([customerId])
  @@index([visitedAt])
}

// -----------------------------------------------------------------------------
// REWARD (Earned Benefit from Loyalty Threshold)
// -----------------------------------------------------------------------------

model Reward {
  id               String         @id @default(cuid())
  membershipId     String
  membership       Membership     @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  businessId       String
  business         Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId       String
  customer         Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  loyaltyProgramId String
  loyaltyProgram   LoyaltyProgram @relation(fields: [loyaltyProgramId], references: [id], onDelete: Restrict)
  title              String
  description        String
  status             RewardStatus      @default(AVAILABLE)
  type               RewardType        @default(STANDARD)
  claimCode          String?           // Used for VISITS program one-time code claim
  scratchCardPrizeId String?
  scratchCardPrize   ScratchCardPrize? @relation(fields: [scratchCardPrizeId], references: [id], onDelete: SetNull)
  isScratched        Boolean           @default(false)
  revealedPrize      String?
  expiresAt        DateTime
  redeemedAt       DateTime?
  redeemedByUserId String?
  redeemedByUser   User?          @relation("RedeemedBy", fields: [redeemedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([membershipId])
  @@index([businessId])
  @@index([customerId])
  @@index([status])
}
